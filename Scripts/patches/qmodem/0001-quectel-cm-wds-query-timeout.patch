diff --git a/application/quectel_CM_5G_M/src/udhcpc.c b/application/quectel_CM_5G_M/src/udhcpc.c
index 4c704e8..e0d62df 100644
--- a/application/quectel_CM_5G_M/src/udhcpc.c
+++ b/application/quectel_CM_5G_M/src/udhcpc.c
@@ -158,6 +158,34 @@ static int ql_raw_ip_mode_check(const char *ifname, uint32_t ip) {
     return mode_change;
 }
 
+static void ql_ensure_qmi_wwan_raw_ip(const char *ifname) {
+    int fd;
+    char raw_ip[128];
+    char mode[2] = "X";
+
+    snprintf(raw_ip, sizeof(raw_ip), "/sys/class/net/%s/qmi/raw_ip", ifname);
+    if (access(raw_ip, F_OK))
+        return;
+
+    fd = open(raw_ip, O_RDWR | O_NONBLOCK | O_NOCTTY);
+    if (fd < 0) {
+        dbg_time("%s fail to open(%s), errno:%d (%s)", __func__, raw_ip, errno, strerror(errno));
+        return;
+    }
+
+    if (read(fd, mode, 2) > 0 && (mode[0] == '0' || mode[0] == 'N')) {
+        ifc_set_state(ifname, 0);
+        dbg_time("echo Y > /sys/class/net/%s/qmi/raw_ip", ifname);
+        mode[0] = 'Y';
+        if (write(fd, mode, 1) != 1) {
+            dbg_time("%s fail to write(%s), errno:%d (%s)", __func__, raw_ip, errno, strerror(errno));
+        }
+        ifc_set_state(ifname, 1);
+    }
+
+    close(fd);
+}
+
 static void* udhcpc_thread_function(void* arg) {
     FILE * udhcpc_fp;
     char *udhcpc_cmd = (char *)arg;
@@ -508,6 +536,10 @@ void udhcpc_start(PROFILE_T *profile) {
 
     ql_set_driver_link_state(profile, 1);
 
+    if (profile->rawIP && qmidev_is_qmiwwan(profile->qmichannel)) {
+        ql_ensure_qmi_wwan_raw_ip(profile->usbnet_adapter);
+    }
+
     if (profile->qmapnet_adapter[0]) {
         ifname = profile->qmapnet_adapter;
     }
