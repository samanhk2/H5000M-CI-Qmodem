#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

start_service() {
	local enabled
	enabled="$(uci -q get modemwebui.config.enabled)"
	[ "$enabled" = "1" ] || return 0
	# modem publishes readiness after discovery, endpoint conversion and CFUN.
	# An absent device must not start an HTTP server with an empty frontend.
	if [ ! -c /dev/modem-at ] || [ ! -f /tmp/modem-service-ready ]; then
		logger -t modemwebui "No ready modem; service not started"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/bin/modemwebui-server
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	# luci-app-modem may commit its package several times while USB siblings,
	# identity and the dial profile converge.  The WebUI follows the stable
	# /dev/modem-at endpoint at runtime; a modem UCI commit must not restart it.
	procd_set_param file /etc/config/modemwebui
	procd_close_instance
}


reload_service() {
	stop
	start
}

service_triggers() {
	# The modem scanner commits its UCI package repeatedly while enumerating
	# ports. Restarting the AT owner for each intermediate commit creates a
	# socket/port race and can make a non-AT tty win automatic detection.
	procd_add_reload_trigger modemwebui
}
