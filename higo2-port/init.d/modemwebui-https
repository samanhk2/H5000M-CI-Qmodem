#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=9
start_service() {
 [ -f /etc/modemwebui/audio-tls/proxy.pem ] || return 0
 local runtime=/var/run/modemwebui/https-proxy.cfg
 umask 077
 mkdir -p /var/run/modemwebui || return 1
 local pending="$runtime.new.$$" result
 /usr/libexec/modemwebui/https-proxy-config > "$pending"
 result=$?
 if [ "$result" != 0 ]; then
  rm -f "$pending"
  [ "$result" = 75 ] && return 0
  return "$result"
 fi
 haproxy -c -f "$pending" || { rm -f "$pending"; return 1; }
 mv "$pending" "$runtime" || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/haproxy -db -f "$runtime"
 procd_set_param respawn
 procd_set_param file "$runtime" /etc/modemwebui/https-proxy.cfg /etc/modemwebui/audio-tls/proxy.pem
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}

service_triggers() {
 procd_add_reload_trigger modemwebui uhttpd
 procd_add_raw_trigger higoros.native-listener 0 /etc/init.d/modemwebui-https start
}
