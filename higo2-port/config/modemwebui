config modemwebui 'config'
	option enabled '1'
	option serial_port 'auto'
	option connection_type 'auto'
	option network_host '192.168.8.1'
	option network_port '20249'
	option baudrate '115200'
	option command_timeout '4'
	option identity_poll_interval '3'
	option identity_failures '3'
	option cfun_ready_timeout '120'
	option traffic_persist_enabled '1'
	option traffic_poll_interval '5'
	option traffic_state_file '/etc/modemwebui/traffic-stats.json'
	option realtime_rate_enabled '0'
	option http_host '0.0.0.0'
	option http_port '8001'
	option websocket_host '0.0.0.0'
	option websocket_port '8765'
	option auth_key ''

